@dataclasses.dataclass(frozen=True)
class Range:
    first: object
    last: object

    def __contains__(self, value):
        if self.first <= self.last:
            return value >= self.first and value <= self.last
        else:
            return value >= self.first or value <= self.last

    def min(self, min):
        return self.first if self.first <= self.last else min

    def max(self, max):
        return self.last if self.first <= self.last else max

    def split(self, min, max):
        if self.first <= self.last:
            return [self]
        return [Range(min, self.last), Range(self.first, max)]

    def _diff(self, other):
        if other.first >= self.last or other.last <= self.first:
            return [self]
        res = []
        if other.first != self.first and other.first in self:
            res.append(Range(self.first, other.first))
        if other.last != self.last and other.last in self:
            res.append(Range(other.last, self.last))
        return res

    def difference(self, others, min, max):
        parts = self.split(min, max)
        for other in others:
            for o in other.split(min, max):
                newparts = []
                for s in parts:
                    newparts.extend(s._diff(o))
                parts = newparts
        return parts


class WrapTime(datetime.time):
    def __to_secs(self, t):
        return (t.hour * 60 + t.minute) * 60 + t.second

    def __add__(self, other):
        if isinstance(other, datetime.timedelta):
            secs = self.__to_secs(self) + int(other.total_seconds())
            usecs = self.microsecond + other.microseconds
            while usecs >= 1000000:
                usecs -= 1000000
                secs += 1
            while secs >= 24 * 60 * 60:
                secs -= 24 * 60 * 60
            while secs < 0:
                secs += 24 * 60 * 60
            return WrapTime(secs // 60 // 60, secs // 60 % 60, secs % 60,
                            usecs, self.tzinfo)
        NotImplemented

    def delta12(self, other):
        if isinstance(other, datetime.time):
            secs = self.__to_secs(self) - self.__to_secs(other)
            usecs = self.microsecond - other.microsecond
            while usecs >= 1000000:
                usecs -= 1000000
                secs += 1
            while usecs <= -1000000:
                usecs += 1000000
                secs -= 1
            if secs >= 12 * 60 * 60:
                secs -= 24 * 60 * 60
            elif secs <= -12 * 60 * 60:
                secs += 24 * 60 * 60
            return datetime.timedelta(seconds=secs, microseconds=usecs)
        NotImplemented

    @classmethod
    def min(self, tzinfo=None):
        return WrapTime(0, 0, 0, 0, tzinfo)

    @classmethod
    def max(self, tzinfo=None):
        return WrapTime(23, 59, 59, 999999, tzinfo)


@dataclasses.dataclass(frozen=True)
@functools.total_ordering
class ShortDate:
    month: int
    day: int

    def __eq__(self, other):
        return (hasattr(other, 'month') and hasattr(other, 'day') and
                self.month == other.month and self.day == other.day)

    def __lt__(self, other):
        if hasattr(other, 'month') and hasattr(other, 'day'):
            return self.month < other.month or (
                self.month == other.month and self.day < other.day)
        return NotImplemented

    def date(self, year):
        return datetime.date(
            getattr(year, 'year', year), self.month, self.day)


@dataclasses.dataclass(frozen=True)
class Rule:
    mode: str
    tzinfo: datetime.tzinfo

    def match(self, day):
        return Range(WrapTime.min(self.tzinfo), WrapTime.max(self.tzinfo))


@dataclasses.dataclass(frozen=True)
class SimpleRule(Rule):
    times: Range
    weekdays: Range = None
    dates: Range = None

    def match(self, day):
        if (self.weekdays is None or day.weekday() in self.weekdays) and \
           (self.dates is None or day in self.dates):
            return self.times


@dataclasses.dataclass(frozen=True)
class LinearRule(Rule):
    range: tuple['Point']

    @dataclasses.dataclass(frozen=True)
    class Point:
        times: Range
        date: ShortDate

        def for_year(self, year):
            return (self.date.date(year), self.times)

    def _bounds(self, day):
        ps = sorted(self.range, key=lambda k: k.date)
        prev = ps[-1].for_year(day.year - 1)
        points = [p.for_year(day) for p in ps] + [ps[0].for_year(day.year + 1)]
        for next in points:
            if next[0] > day:
                break
            prev = next
        return prev[0], prev[1], next[0], next[1]

    def _time(self, prev_day, prev_time, cur_day, next_day, next_time):
        total_rise = next_time.delta12(prev_time)
        total_run = next_day - prev_day
        cur_run = cur_day - prev_day
        cur_rise = total_rise * (cur_run / total_run)
        return prev_time + cur_rise

    def match(self, day):
        prev_d, prev_t, next_d, next_t = self._bounds(day)
        return Range(
            self._time(prev_d, prev_t.first, day, next_d, next_t.first),
            self._time(prev_d, prev_t.last, day, next_d, next_t.last))


@dataclasses.dataclass(frozen=True)
class RuleSet:
    rules: tuple[Rule]
    tzinfo: datetime.tzinfo

    def _mode_ranges_for_day(self, day):
        matched = set()
        ret = []
        for rule in self.rules:
            if rule.mode not in matched:
                match = rule.match(day)
                if match is not None:
                    matched.add(rule.mode)
                    ret.append((rule.mode, match))
        fallback = Rule('default', self.tzinfo)
        ret.append((fallback.mode, fallback.match(day)))
        return tuple(ret)

    def _mode_for_time(self, when, mode_ranges):
        for mode, range in mode_ranges:
            if when in range:
                return mode

    def _transitions_for_mode_ranges(self, mr):
        ret = {}
        for mode, range in mr:
            for when in (range.first, range.min(WrapTime.min(self.tzinfo))):
                if when not in ret and mode == self._mode_for_time(when, mr):
                    ret[when] = mode
            for when in (range.last, range.max(WrapTime.max(self.tzinfo))):
                if when not in ret and \
                   mode == self._mode_for_time(when, mr) and \
                   when != WrapTime.max(self.tzinfo):
                    when += datetime.time.resolution
                    found_mode = self._mode_for_time(when, mr)
                    if mode != found_mode:
                        ret[when] = found_mode
        return tuple((ret[t], t) for t in sorted(ret.keys()))

    def lookup(self, when):
        day = when.date()
        when = when.timetz()
        mr = self._mode_ranges_for_day(day)
        prev_mode = self._mode_for_time(when, mr)
        next_change = datetime.datetime.combine(
            day, WrapTime.max(self.tzinfo)) + datetime.timedelta.resolution
        for _, change_time in self._transitions_for_mode_ranges(mr):
            change_dt = datetime.datetime.combine(day, change_time)
            if change_time > when and change_dt < next_change:
                next_change = change_dt
        return prev_mode, next_change

    def schedule_for_day(self, day):
        return self._transitions_for_mode_ranges(
            self._mode_ranges_for_day(day))


class Parser:
    def __init__(self, tzinfo=None):
        pp.ParserElement.inline_literals_using(pp.Suppress)
        self._tz = tzinfo
        self._day_month = None
        self._grammar = self._get_grammar()

    def _reset(self):
        self._day_month = True

    def _kw(self, match_string):
        return pp.CaselessKeyword(match_string, ident_chars=pp.alphas)

    def _one_of_kw(self, choices):
        return pp.Or(map(self._kw, choices.split()))

    def _one_of_kw_value(self, choices, value):
        return self._one_of_kw(choices).set_parse_action(lambda t: value)

    def _as_int(self, tok):
        return tok.set_parse_action(lambda t: int(t[0]))

    def _as_range(self, tok):
        return pp.Group(tok.set_parse_action(lambda t: Range(t[0], t[1])))

    def _get_settings_section(self):
        k_DATE = self._kw('date')
        FMT = pp.Suppress(self._kw('format'))
        MONTH = pp.Suppress(self._kw('month'))
        DAY = pp.Suppress(self._kw('day'))
        SET = pp.Suppress(self._kw('set'))

        date_fmt_md = (MONTH + '/' + DAY).set_parse_action(
            lambda t: setattr(self, '_day_month', False))
        date_fmt_dm = (DAY + '/' + MONTH).set_parse_action(
            lambda t: setattr(self, '_day_month', True))
        set_date = k_DATE + FMT + '=' + (date_fmt_md ^ date_fmt_dm)

        set_any = set_date('date')
        return pp.Dict(pp.Group(SET + set_any)[...])

    def _get_mode_specifier(self):
        expr = (self._one_of_kw_value('def default', 'default') ^
                self._one_of_kw_value('dark night', 'dark') ^
                self._one_of_kw_value('light day', 'light'))
        return expr.set_parse_action(lambda t: Rule(t[0], self._tz))

    def _get_time_specifier(self):
        hour_lit = self._as_int(pp.Word(pp.nums, min=1, max=2))('hour')
        min_lit = self._as_int(pp.Word(pp.nums, exact=2))('minute')
        ampm_lit = self._one_of_kw('AM PM')('ampm')
        time_expr = hour_lit + pp.Opt(':' + min_lit) + pp.Opt(ampm_lit)
        return pp.Dict(pp.Group(time_expr)).set_parse_action(self._time_act)

    def _time_act(self, src, loc, tok):
        tok = tok[0]
        hour = tok.hour
        if 'ampm' in tok:
            if hour == 12:
                hour = 0 if tok.ampm == 'AM' else 12
            elif tok.ampm == 'PM':
                hour += 12
        if hour < 0 or hour > 23:
            raise pp.ParseException(src, loc, 'hour value out of range')
        minute = 0
        if 'minute' in tok:
            minute = tok.minute
            if minute < 0 or minute > 59:
                raise pp.ParseException(
                    src, loc, 'minute value out of range')
        return WrapTime(hour, minute, tzinfo=self._tz)

    def _get_weekday_specifier(self):
        return (self._one_of_kw_value('Mon Monday', 0) ^
                self._one_of_kw_value('Tue Tuesday', 1) ^
                self._one_of_kw_value('Wed Wednesday', 2) ^
                self._one_of_kw_value('Thu Thursday', 3) ^
                self._one_of_kw_value('Fri Friday', 4) ^
                self._one_of_kw_value('Sat Saturday', 5) ^
                self._one_of_kw_value('Sun Sunday', 6))

    def _get_date_specifier(self):
        month = (self._one_of_kw_value('Jan January', 1) ^
                 self._one_of_kw_value('Feb February', 2) ^
                 self._one_of_kw_value('Mar March', 3) ^
                 self._one_of_kw_value('Apr April', 4) ^
                 self._one_of_kw_value('May May', 5) ^
                 self._one_of_kw_value('Jun June', 6) ^
                 self._one_of_kw_value('Jul July', 7) ^
                 self._one_of_kw_value('Aug August', 8) ^
                 self._one_of_kw_value('Sep September', 9) ^
                 self._one_of_kw_value('Oct October', 10) ^
                 self._one_of_kw_value('Nov November', 11) ^
                 self._one_of_kw_value('Dec December', 12))
        int_lit = self._as_int(pp.Word(pp.nums, min=1, max=2))
        num_expr = (int_lit + '/' + int_lit)('unparsed')
        name_expr = int_lit('day') & month('month')
        date_expr = num_expr ^ name_expr
        return pp.Group(date_expr).set_parse_action(self._date_act)

    def _date_act(self, src, loc, tok):
        tok = tok[0]
        if 'unparsed' in tok:
            if self._day_month:
                day, month = tok.unparsed
            else:
                month, day = tok.unparsed
            if month < 1 or month > 12:
                raise pp.ParseException(
                    src, loc, 'month value out of range')
        else:
            month, day = tok.month, tok.day
        try:
            datetime.date(2001, month, day)
            return ShortDate(month, day)
        except ValueError as e:
            raise pp.ParseException(src, loc, e.args[0])

    def _get_rules_section(self):
        USE = pp.Suppress(self._kw('use'))
        MODE = pp.Suppress(self._kw('mode'))
        LINE = pp.Suppress(self._kw('linear'))
        FROM = pp.Suppress(self._kw('from'))
        TO = pp.Suppress(self._kw('to'))
        THRU = pp.Suppress(self._kw('through'))
        ON = pp.Suppress(self._kw('on'))
        COM = pp.Opt(',')

        time_spec = self._get_time_specifier()
        wday_spec = self._get_weekday_specifier()
        date_spec = self._get_date_specifier()
        mode_spec = self._get_mode_specifier()

        mode_clause = mode_spec('mode') + MODE
        time_clause = self._as_range(time_spec + TO + time_spec)('time')
        wday_clause = self._as_range(wday_spec + THRU + wday_spec)('weekday')
        date_clause = self._as_range(date_spec + '-' + date_spec)('date')
        line_clause = (time_clause + ON + date_spec('date')).set_parse_action(
            lambda t: LinearRule.Point(t.time[0], t.date))

        rule_line = mode_clause + LINE + (line_clause + COM)[1, ...]('range')
        rule_line.set_parse_action(
            lambda t: LinearRule(t.mode.mode, self._tz, tuple(t.range)))
        rule_4 = mode_clause + FROM + time_clause + COM + (
            pp.Opt(wday_clause + COM) & pp.Opt(date_clause + COM))
        rule_4.set_parse_action(
            lambda t: SimpleRule(t.mode.mode, self._tz, t.time[0],
                                 weekdays=t.get('weekday', [None])[0],
                                 dates=t.get('date', [None])[0]))
        any_rule = USE + (mode_clause ^ rule_4 ^ rule_line)
        return pp.Dict(pp.Group(any_rule)[...])

    def _get_grammar(self):
        set_sect = self._get_settings_section()
        rule_sect = self._get_rules_section()
        grammar = set_sect('settings') + rule_sect('rules')
        grammar.ignore('#' + pp.rest_of_line)
        return grammar

    def _process(self, result):
        rules = []
        for rule in result.rules:
            rules.extend(rule)
        return RuleSet(tuple(rules), tzinfo=self._tz)

    def load(self, file):
        self._reset()
        return self._process(self._grammar.parse_file(file, parse_all=True))

    def loads(self, input):
        self._reset()
        return self._process(self._grammar.parse_string(input, parse_all=True))


class Scheduler(object):
    def __init__(self, config_path, settings):
        self._config_path = config_path
        self._settings = settings
        self._parser = Parser()
        self._ruleset = None
        try:
            self._timerfd = os.timerfd_create(
                time.CLOCK_REALTIME, flags=os.TFD_NONBLOCK | os.TFD_CLOEXEC)
            GLib.unix_fd_add_full(GLib.PRIORITY_DEFAULT,
                                  self._timerfd,
                                  GLib.IOCondition.IN,
                                  self._handle_timerfd)
        except AttributeError:
            self._timerfd = None
            signal.signal(signal.SIGALRM, self._handle_sigalrm)
        self._reload_config()
        self._scheduled_update('initial')
        signal.signal(signal.SIGHUP, self._handle_sighup)

    def _reload_config(self):
        self._ruleset = None
        try:
            logging.debug('reading config from %s' % (self._config_path,))
            self._ruleset = self._parser.load(self._config_path)
        except Exception:
            logging.exception('failed to read config from %s' % (
                self._config_path,))

    def _handle_sighup(self, sig, frame):
        self._reload_config(self)
        self._scheduled_update('reload')

    def _handle_sigalrm(self, sig, frame):
        self._scheduled_update('scheduled')

    def _handle_timerfd(self, fd, cond):
        os.read(self._timerfd, 8)
        self._scheduled_update('scheduled')
        return True

    def _alarm(self, when, now):
        if self._timerfd is None:
            if when and now:
                signal.alarm(math.ceil((when - now).total_seconds()))
            else:
                signal.alarm(0)
        else:
            if when:
                os.timerfd_settime(self._timerfd,
                                   flags=os.TFD_TIMER_ABSTIME,
                                   initial=when.timestamp())
            else:
                os.timerfd_settime(self._timerfd, flags=os.TFD_TIMER_ABSTIME)

    def _scheduled_update(self, reason):
        if self._ruleset is None:
            self._alarm(None, None)
        else:
            now = datetime.datetime.now()
            cur_scheme, next_change = self._ruleset.lookup(now)
            logging.debug('update (%s) to %s at %s, next at %s' % (
                reason, cur_scheme, now.ctime(), next_change.ctime()))
            self._settings.set_color_scheme(cur_scheme)
            self._alarm(next_change, now)


class XdgDesktopPortalErrorNotFound(dbus.DBusException):
    include_traceback = False
    _dbus_error_name = 'org.freedesktop.portal.Error.NotFound'


class SettingsPortal(dbus.service.Object):
    _obj_path = '/org/freedesktop/portal/desktop'
    _namespace = 'org.freedesktop.appearance'
    _color_scheme = 'color-scheme'

    def __init__(self, bus_name, backend):
        super().__init__(bus_name=bus_name, object_path=self._obj_path)
        self._backend = backend
        self._scheme = None
        self._save_scheme()
        backend.handle_color_scheme_changed(self._backend_changed)

    def _save_scheme(self):
        newval = self._backend.get_color_scheme()
        if newval == self._scheme:
            logging.debug('color-scheme unchanged: %r' % (newval,))
            return False
        self._scheme = newval
        logging.debug('read color scheme setting: %r' % (self._scheme,))
        return True

    def _get_scheme(self, variant_level=0):
        return dbus.UInt32(self._scheme, variant_level=variant_level)

    def _backend_changed(self):
        if self._save_scheme():
            self.SettingChanged(
                self._namespace, self._color_scheme, self._get_scheme(1))

    def _not_found(self):
        raise XdgDesktopPortalErrorNotFound('Requested setting not found')

    @dbus.service.method(dbus_interface=portal_impl_settings_iface,
                         in_signature='as', out_signature='a{sa{sv}}')
    def ReadAll(self, namespaces):
        logging.debug('method ReadAll(%r)' % (namespaces,))
        res = {}
        for namespace in namespaces:
            if namespace == self._namespace:
                res[namespace] = {self._color_scheme: self._get_scheme(1)}
            else:
                self._not_found()
        logging.debug('returning %r' % (res,))
        return res

    @dbus.service.method(dbus_interface=portal_impl_settings_iface,
                         in_signature='ss', out_signature='v')
    def Read(self, namespace, key):
        logging.debug('method Read(%r, %r)' % (namespace, key))
        if namespace == self._namespace and key == self._color_scheme:
            res = self._get_scheme(2)
            logging.debug('returning %r' % (res,))
            return res
        self._not_found()

    @dbus.service.method(dbus_interface=portal_impl_settings_iface,
                         in_signature='ss', out_signature='v')
    def ReadOne(self, namespace, key):
        logging.debug('method ReadOne(%r, %r)' % (namespace, key))
        if namespace == self._namespace and key == self._color_scheme:
            res = self._get_scheme(1)
            logging.debug('returning %r' % (res,))
            return res
        self._not_found()

    @dbus.service.signal(dbus_interface=portal_impl_settings_iface,
                         signature='ssv')
    def SettingChanged(self, namespace, key, value):
        logging.debug('signaling SettingChanged(%r, %r, %r)' % (
            namespace, key, value))


class SettingsBackend(object):
    _schemas = ('org.gnome.desktop.interface', 'org.x.apps.portal')
    _key = 'color-scheme'

    def __init__(self):
        # XXX install my own gsettings schema if below isn't found
        schema_source = Gio.SettingsSchemaSource.get_default()

        self._gs = None
        for schema in self._schemas:
            if self._gs is None and schema_source.lookup(schema, True):
                logging.debug('found GSettings schema %s' % (schema,))
                self._gs = Gio.Settings.new(schema)

        if self._gs is None:
            print('failed to find a GSettings schema in %s' % (
                ', '.join(schema)), file=sys.stderr)
            sys.exit(1)

        self._change_handlers = set()
        self._gs.connect('changed::%s' % (self._key,), self._on_changed)

    def _numeric(self, val):
        if val == 'dark' or val == 1:
            return 1
        elif val == 'light' or val == 2:
            return 2
        return 0

    def _on_changed(self, *args):
        logging.debug('signaled that GSettings color-scheme changed')
        for fn in self._change_handlers:
            fn()

    def handle_color_scheme_changed(self, fn):
        self._change_handlers.add(fn)

    def get_color_scheme(self):
        return self._numeric(self._gs.get_enum(self._key))

    def set_color_scheme(self, val):
        self._gs.set_enum(self._key, self._numeric(val))


def dump_schedule(config_path, out):
    def fmt(arg):
        mode, when = arg
        if when.hour == 0 and when.minute == 0 and when.second == 0:
            return mode
        if when.microsecond >= 500000 and \
           (when.hour != 23 or when.minute != 59 or when.second != 59):
            when += datetime.timedelta(seconds=1)
        when = when.replace(microsecond=0)
        return '%s %s' % (when.strftime('%H:%M:%S'), mode)

    rules = Parser().load(config_path)
    year = datetime.datetime.now().year
    day = datetime.date(year, 1, 1)
    while day.year == year:
        sched = '  -  '.join(map(fmt, rules.schedule_for_day(day)))
        print(day.strftime('%b %e'), sched, file=out)
        day += datetime.timedelta(days=1)


def main():
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)

    parser = argparse.ArgumentParser(
        description='''An xdg-desktop-portal backend which only
        implements nothing except the desktop color scheme via
        gsettings. ''',
        epilog='''For more information, see
        https://flatpak.github.io/xdg-desktop-portal/''')
    parser.add_argument('-c', '--conf', metavar='FILE',
                        help='path to the configuration file')
    parser.add_argument('-v', '--verbose', default=False, action='store_true',
                        help='enable extra debugging output')
    parser.add_argument('-r', '--replace', default=False, action='store_true',
                        help='replace existing instance')
    parser.add_argument('--dump-schedule', default=False, action='store_true',
                        help='Dump the configured schedule for the year')

    args = parser.parse_args()
    logging.basicConfig(
        format=(parser.prog.replace('%', '%%') + ': %(levelname)s: %(message)s'),
        level=(logging.DEBUG if args.verbose else logging.ERROR))
    config_path = args.conf or \
        os.path.join(GLib.get_user_config_dir(), default_config_file_name)

    if args.dump_schedule:
        dump_schedule(config_path, sys.stdout)
        return

    backend = SettingsBackend()
    scheduler = Scheduler(config_path, backend)  # noqa: F841

    # XXX what happens when this is replaced?
    session = dbus.SessionBus()
    bus_name = dbus.service.BusName(portal_impl_service_name, session,
                                    allow_replacement=True,
                                    replace_existing=args.replace)
